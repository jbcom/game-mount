{
  "name": "@arcade-cabinet/babylon-mount",
  "version": "0.1.0",
  "description": "Reactylon companion primitives for arcade-cabinet games: useBeforeRender, phase-gated SceneRoot, cached useHavokPhysics, mobile-aware engine options, and iOS safe-area insets. Extracted from martian-trail.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbcom/babylon-mount.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/babylon-mount/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:consumer"
  },
  "peerDependencies": {
    "@babylonjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@babylonjs/havok": "^1.0.0",
    "react": "^18 || ^19",
    "reactylon": "^3.0.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.6.2",
    "@babylonjs/havok": "^1.3.12",
    "@biomejs/biome": "2.5.15",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "jsdom": "^29",
    "react": "^19.2.6",
    "reactylon": "^3.5.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
