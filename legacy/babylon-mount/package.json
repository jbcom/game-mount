{
  "name": "@arcade-cabinet/babylon-mount",
  "version": "0.1.0",
  "description": "Reactylon companion primitives: useBeforeRender, phase-gated SceneRoot, cached useHavokPhysics, mobile-aware engine options, and iOS safe-area insets — extracted from martian-trail.",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@babylonjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@babylonjs/havok": "^1.0.0",
    "react": "^18 || ^19",
    "reactylon": "^3.0.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.6.2",
    "@babylonjs/havok": "^1.3.12",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "jsdom": "^29",
    "react": "^19.2.6",
    "reactylon": "^3.5.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
