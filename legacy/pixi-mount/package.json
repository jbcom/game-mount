{
  "name": "@arcade-cabinet/pixi-mount",
  "version": "0.2.0",
  "description": "Pixi 8 Application mount/unmount lifecycle — fresh-canvas StrictMode safety, single onResize-driven ResizeObserver, DPR cap, reduced-motion gate — for React and plain DOM games.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbcom/pixi-mount.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/pixi-mount/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.cjs"
    },
    "./pixi-react": {
      "types": "./dist/types/pixi-react.d.ts",
      "import": "./dist/esm/pixi-react.js",
      "require": "./dist/cjs/pixi-react.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:jsdom && pnpm run test:browser",
    "test:jsdom": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:consumer",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@pixi/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@pixi/react": "8.0.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "29.1.1",
    "pixi.js": "8.22.0",
    "playwright": "1.61.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
