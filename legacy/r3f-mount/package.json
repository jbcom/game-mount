{
  "name": "@arcade-cabinet/r3f-mount",
  "version": "0.1.0",
  "description": "Parent-sized react-three-fiber Canvas mount: CabinetCanvas (phase-gated mount, quality-tiered dpr, baked WebGL context-loss handling), CabinetCanvasErrorBoundary (asset-load classification), AdaptiveResolution (FPS-driven pixel-ratio ladder), and the .cabinet-canvas-host CSS contract. Extracted from welcoming-wilds-island-adventure.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbcom/r3f-mount.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/r3f-mount/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:consumer"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^18 || ^19",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-three/fiber": "^9.6.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/three": "^0.184.1",
    "jsdom": "^29",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
